{
	"name": "vibe-financer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "bun i drizzle-kit && bun x drizzle-kit migrate && bun --bun ./build/index.js",
		"dev": "vite dev --port 5124",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check --write . && eslint --fix .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun x drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@types/bun": "^1.3.13",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^24.12.2",
		"@types/pg": "^8.20.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^16.5.0",
		"layerchart": "^2.0.0-next.62",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.55.5",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.4.7",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^7.3.2"
	},
	"dependencies": {
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@sveltejs/kit": "^2.59.0",
		"@tanstack/svelte-query": "^6.1.28",
		"@tanstack/svelte-query-devtools": "^6.1.28",
		"@types/d3-shape": "^3.1.8",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"pg": "^8.20.0"
	}
}
